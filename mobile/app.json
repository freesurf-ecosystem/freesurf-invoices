{
  "expo": {
    "name": "Invoices",
    "slug": "cnxt-to-invoice-mobile",
    "owner": "freesurf",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "freesurf-invoices",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f1ea"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "tools.freesurf.invoices",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "tools.freesurf.invoices",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Your device identifier is used to serve personalized ads and keep FreeSurf free."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "9255692f-c4e4-4999-89a8-4e0de5f14377"
      }
    },
    "plugins": [
      "expo-tracking-transparency",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Invoices to access your photos to attach receipts and logos.",
          "cameraPermission": "Allow Invoices to access your camera to capture receipts and logos.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native",
        {
          "organization": "freesurf",
          "project": "react-native"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.3.0",
            "useLegacyPackaging": false
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5237160801083269~6464265711",
          "iosAppId": "ca-app-pub-5237160801083269~6464265711"
        }
      ]
    ]
  }
}
